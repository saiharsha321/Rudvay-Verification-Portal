# Next.js Public Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rudvaytech-cert.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rudvaytech-cert
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rudvaytech-cert.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Backend Cloud Function Base URL
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=https://certifications.rudvay.tech
NEXT_PUBLIC_VERIFY_BASE_URL=https://certifications.rudvay.tech/verify

# Python Backend Settings (Functions)
FIREBASE_PROJECT_ID=rudvaytech-cert
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@rudvaytech.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=certificates@rudvaytech.com
SMTP_FROM_NAME=Rudvay Tech Certifications
SMTP_USE_TLS=true
APP_SECRET_KEY=your-cryptographic-master-key-32-chars-minimum
